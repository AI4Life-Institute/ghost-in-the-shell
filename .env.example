# === Platform ===
DISCORD_BOT_TOKEN=your-discord-bot-token

# === Access Control ===
ALLOWED_USERS=123456789,987654321
ALLOWED_GUILDS=111111111

# === tmux ===
TMUX_SESSION_NAME=gits
CODING_CLI_COMMAND=claude

# === Screenshot ===
SCREENSHOT_FONT_SIZE=28

# === Monitoring ===
PANE_POLL_INTERVAL=2.0
JSONL_POLL_INTERVAL=2.0

# === Security ===
ALLOWED_PATHS=/home/user/projects,/data/projects

# === Optional ===
GITS_DIR=~/.gits
LOG_LEVEL=INFO
